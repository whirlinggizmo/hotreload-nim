{
    "version": "2.0.0",
    "problemMatcher": {
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*\\.nim)\\((\\d+),\\s*(\\d+)\\)\\s+(Error|Warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
    },
    "presentation": {
        "echo": true,
        "reveal": "always",
        "revealProblems": "onProblem",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true,
        "close": false
    },
    "promptOnClose": false,
    "tasks": [
        {
            "label": "simple: build hot",
            "type": "shell",
            "command": "nim build hot",
            "options": { "cwd": "${workspaceFolder}/examples/simple" },
            "group": {
                "kind": "build",
                "isDefault": false
            },
        },
        {
            "label": "simple: build debug",
            "type": "shell",
            "command": "nim build debug",
            "options": { "cwd": "${workspaceFolder}/examples/simple" },
            "group": "build"
        },
        {
            "label": "simple: build release",
            "type": "shell",
            "command": "nim build release",
            "options": { "cwd": "${workspaceFolder}/examples/simple" },
            "group": "build"
        }
    ]
}

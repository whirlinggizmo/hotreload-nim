{
    "files.associations": {
        "*.nimble": "nimble"
    },
    "nim.useNimCheck": true,
    // one nimsuggest for the example, not one per file opened: its modules and hotreload's
    // are all seen from its main module
    "nim.projectMapping": [
        { "projectFile": "examples/simple/src/main.nim", "fileRegex": "(examples/simple/src|src/hotreload)/.*\\.nim$" }
    ],
    "nim.buildOnSave": false,

    "editor.renderWhitespace": "all",
    "editor.tabSize": 2
}
